# Banco de dados Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/membershub"

# Segredo usado para assinar o cookie de sessão (gere uma string aleatória longa)
SESSION_SECRET="change-me-to-a-long-random-string"

# Token enviado pela Hotmart no header X-HOTMART-HOTTOK (configurado no painel do produtor)
HOTMART_HOTTOK="change-me"

# Envio de e-mail transacional (Resend). Se vazio, o sistema loga as credenciais
# em vez de enviar e-mail (útil em desenvolvimento).
RESEND_API_KEY=""
EMAIL_FROM="Members Hub <acesso@seudominio.com>"

# URL pública da aplicação (usada em links de e-mail)
APP_URL="http://localhost:3000"

# Armazenamento dos arquivos de conteúdo: "local" ou "r2"
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# Cloudflare R2 (necessário apenas se STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
